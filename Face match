<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Face to Animal Matcher - Final Version</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 30px;
      background-image: url('https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1350&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: white;
    }
    input[type="file"] {
      margin: 20px;
      padding: 10px;
      background: rgba(255,255,255,0.2);
      border: none;
      color: white;
      border-radius: 5px;
      cursor: pointer;
    }
    button {
      padding: 12px 25px;
      font-size: 18px;
      background-color: #28a745;
      border: none;
      color: white;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
    }
    button:hover {
      background-color: #218838;
    }
    img {
      margin-top: 20px;
      width: 300px;
      border-radius: 12px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.5);
    }
    #thinking {
      font-size: 22px;
      margin-top: 20px;
      font-weight: bold;
      color: #ffeb3b;
      display: none;
    }
    #result {
      margin-top: 30px;
    }
  </style>
</head>
<body>

<h1>Upload Your Photo</h1>
<input type="file" id="upload" accept="image/*"><br>
<button onclick="startAnalysis()">Find Your Animal Match!</button>

<div id="thinking">Thinking... Analyzing your face...</div>
<div id="result"></div>

<script>
  const animals = [
    { name: "Dog", img: "https://i.imgur.com/1h5ZMEU.jpg" },
    { name: "Cat", img: "https://i.imgur.com/6X1K5Ro.jpg" },
    { name: "Panda", img: "https://i.imgur.com/IhGDcLa.jpg" },
    { name: "Lion", img: "https://i.imgur.com/B0IUJc2.jpg" },
    { name: "Monkey", img: "https://i.imgur.com/yAY5GuI.jpg" },
    { name: "Elephant", img: "https://i.imgur.com/1UJNz2m.jpg" },
    { name: "Eagle", img: "https://i.imgur.com/n90D34T.jpg" },
    { name: "Peacock", img: "https://i.imgur.com/6HQAlrF.jpg" },
    { name: "Unicorn", img: "https://i.imgur.com/QxhhNYW.jpg" },
    { name: "Dragon", img: "https://i.imgur.com/SsU7mIo.jpg" }
  ];

  function startAnalysis() {
    const upload = document.getElementById('upload').files[0];
    const thinking = document.getElementById('thinking');
    const result = document.getElementById('result');

    if (!upload) {
      alert("Please upload a photo first!");
      return;
    }

    thinking.style.display = 'block';
    result.innerHTML = '';

    setTimeout(() => {
      thinking.style.display = 'none';

      const randomAnimal = animals[Math.floor(Math.random() * animals.length)];

      result.innerHTML = `
        <h2>Your Animal Match:</h2>
        <img src="${randomAnimal.img}" alt="${randomAnimal.name}">
        <h3>You are matched with a <strong>${randomAnimal.name}</strong>!</h3>
      `;
    }, 3000);
  }
</script>

</body>
</html>
